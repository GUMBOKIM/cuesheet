{
  "name": "@cuesheet/react",
  "version": "1.0.2",
  "description": "React control panel for cuesheet.",
  "keywords": [
    "cuesheet",
    "msw",
    "mock",
    "react",
    "devtools",
    "panel"
  ],
  "license": "MIT",
  "author": "GUMBOKIM (https://github.com/GUMBOKIM)",
  "homepage": "https://github.com/GUMBOKIM/cuesheet#readme",
  "bugs": "https://github.com/GUMBOKIM/cuesheet/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GUMBOKIM/cuesheet.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "LICENSE",
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@cuesheet/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "cuesheet": "workspace:^",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cuesheet": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
